Package: MrDAG
Type: Package
Title: Bayesian Causal Graphical Model for Joint Mendelian Randomization Analysis of Multiple Exposures and Outcomes
Version: 0.1.3
Date: 2026-10-25
Authors@R: c(
    person("Leonardo", "Bottolo", email = "lb664@cam.ac.uk", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-6381-2327")),
    person("Verena", "Zuber", email = "v.zuber@imperial.ac.uk", role = c("aut", "ctb"),
